DB_HOST=127.0.0.1
DB_NAME=lms
DB_USER=root
DB_PASS=
APP_DEBUG=1

# Facoltative: necessarie solo se si usano video con provider 'bunny' o 'cloudflare'
BUNNY_LIBRARY_ID=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# URL pubblico dell'applicazione: usato nel PDF del certificato per il link di verifica
APP_URL=http://localhost:8000

# Sessioni live su Google Meet (facoltative): senza queste variabili le sessioni
# si creano comunque, ma il link Meet va inserito a mano.
# Percorso del file JSON della chiave dell'account di servizio (fuori dal document root)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Utente Workspace impersonato via delega a livello di dominio: necessario per generare i link Meet
GOOGLE_IMPERSONATE_EMAIL=
# Calendario su cui creare gli eventi ("primary" = quello dell'utente impersonato)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Rome

# Fuso orario dell'applicazione
APP_TIMEZONE=Europe/Rome

# Invio email (registrazione, verifica indirizzo, recupero password)
# MAIL_TRANSPORT: log = salva i messaggi in storage/mail (sviluppo locale)
#                 smtp = server SMTP esterno
#                 mail = funzione mail() di PHP (richiede un MTA sul server)
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS, porta 587), ssl (porta 465) oppure none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Pistacchio LMS
