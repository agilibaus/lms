#
# Analisi statica del codice.  Esecuzione:  phpstan analyse
#
# Cartelle analizzate: tutto il PHP scritto in casa. Restano fuori `vendor`
# (non e' codice nostro), `database` (solo .sql) e `storage` (solo file
# caricati). Le viste ci sono: i blocchi `@var` in cima a ciascuna dichiarano
# le variabili che arrivano dal controller, quindi non producono rumore.
#
# Non serve `bootstrapFiles`: PHPStan legge composer.json e usa l'autoload
# PSR-4 del progetto, cosi' trova sia App\ sia Dompdf.
#
# Livello 8 (dal 29/09, pistacchio-lms.md §8.1): e' il livello che segnala le
# righe lette dal database senza controllare che esistano — `$module = find()`
# seguito da `$module['course_id']`. Tre famiglie di rilievi restano escluse,
# ciascuna per un motivo preciso, qui sotto.
#
parameters:
    level: 8

    paths:
        - app
        - config
        - public
        - tests

    ignoreErrors:
        # Il tipo del contenuto di ogni array: le righe del database girano
        # come array associativi, e annotarle tutte sarebbe un lavoro a se',
        # da decidere, non una spunta da mettere.
        -
            identifier: missingType.iterableValue

        # Argomenti di tipo piu' largo di quanto la funzione dichiara (per
        # esempio un int|string dove si aspetta un int). Non sono difetti: il
        # codice li converte dove servono.
        -
            identifier: argument.type

        # query() e prepare() "potrebbero" restituire false, ma la connessione
        # e' aperta con PDO::ERRMODE_EXCEPTION (Core/Database.php): se una
        # query fallisce PDO lancia un'eccezione, e false non arriva mai.
        -
            message: '#^Cannot call method \w+\(\) on PDOStatement\|false\.$#'

        # I test contano gli errori in una variabile globale che check()
        # modifica a ogni asserzione. PHPStan non segue quella scrittura e
        # crede che $fail resti a zero, quindi legge l'ultima riga di ogni
        # test — exit($fail === 0 ? 0 : 1) — come un confronto sempre vero.
        -
            identifier: identical.alwaysTrue
            path: tests/*
