#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Gli studenti del test di carico (06/11): li crea prima della prova e li
 * toglie dopo. Lo script k6 sta in `tests/carico/`, con le istruzioni in
 * `tests/carico/LEGGIMI.md`.
 *
 *   php bin/carico semina --corso=12 --password=UnaPasswordLunga
 *   php bin/carico semina --corso=12 --corso=15 --quanti=500 --password=...
 *   php bin/carico togli
 *   php bin/carico conta
 *
 * `semina` crea gli studenti carico-001@carico.invalid ... carico-500@...
 * (dominio .invalid: nessuna email puo' arrivare davvero), tutti con la
 * stessa password, gia' verificati, oltre il primo accesso, e li iscrive ai
 * corsi dati, che devono essere pubblicati. Senza «Iscrizione confermata» in
 * coda. A meta' di loro segna fatta la prima lezione di ogni corso, cosi'
 * le pagine mostrano anche un avanzamento. Si puo' rieseguire: chi c'e' gia'
 * resta com'e'.
 *
 * `togli` cancella tutti gli utenti @carico.invalid: iscrizioni, avanzamenti,
 * tentativi, accessi e tutto il resto se ne vanno con loro (le tabelle sono
 * legate agli utenti con ON DELETE CASCADE). E' la seconda rete: la prima e'
 * la copia del database fatta prima della prova, da ripristinare dopo.
 *
 * `conta` dice quanti sono e a quanti corsi sono iscritti.
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit("Questo comando si esegue dal terminale.\n");
}

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/../config/config.php';

use App\Core\Database;

const DOMINIO = '@carico.invalid';

$comando = $argv[1] ?? '';
$corsi = [];
$password = '';
$quanti = 500;

foreach (array_slice($argv, 2) as $arg) {
    if (preg_match('/^--corso=(\d+)$/', $arg, $m) === 1) {
        $corsi[] = (int) $m[1];
    } elseif (preg_match('/^--password=(.+)$/', $arg, $m) === 1) {
        $password = $m[1];
    } elseif (preg_match('/^--quanti=(\d+)$/', $arg, $m) === 1) {
        $quanti = (int) $m[1];
    } else {
        fwrite(STDERR, "Opzione sconosciuta: {$arg}\n");
        exit(2);
    }
}

$pdo = Database::connection();

/** L'indirizzo dello studente numero $n: carico-001@carico.invalid. */
function indirizzo(int $n): string
{
    return sprintf('carico-%03d', $n) . DOMINIO;
}

if ($comando === 'conta') {
    $utenti = (int) $pdo->query("SELECT COUNT(*) FROM users WHERE email LIKE '%" . DOMINIO . "'")->fetchColumn();
    $iscrizioni = (int) $pdo->query(
        "SELECT COUNT(*) FROM enrollments e INNER JOIN users u ON u.id = e.user_id WHERE u.email LIKE '%" . DOMINIO . "'"
    )->fetchColumn();
    echo "Studenti del test di carico: {$utenti}; iscrizioni: {$iscrizioni}.\n";
    exit(0);
}

if ($comando === 'togli') {
    $tolti = $pdo->exec("DELETE FROM users WHERE email LIKE '%" . DOMINIO . "'");
    echo "Tolti {$tolti} studenti del test di carico, con tutto quello che avevano.\n";
    exit(0);
}

if ($comando !== 'semina') {
    fwrite(STDERR, "Uso: php bin/carico semina --corso=ID [--corso=ID] --password=... [--quanti=500]\n"
        . "     php bin/carico togli\n     php bin/carico conta\n");
    exit(2);
}

if ($corsi === []) {
    fwrite(STDERR, "Manca il corso: --corso=ID (il numero si legge nell'indirizzo della sua pagina).\n");
    exit(2);
}

if (mb_strlen($password) < 12) {
    fwrite(STDERR, "La password degli studenti di prova deve avere almeno 12 caratteri: --password=...\n");
    exit(2);
}

if ($quanti < 1 || $quanti > 999) {
    fwrite(STDERR, "--quanti va da 1 a 999.\n");
    exit(2);
}

foreach ($corsi as $c) {
    $stmt = $pdo->prepare('SELECT title, is_published FROM courses WHERE id = :id');
    $stmt->execute(['id' => $c]);
    $corso = $stmt->fetch();

    if ($corso === false) {
        fwrite(STDERR, "Il corso {$c} non esiste.\n");
        exit(1);
    }

    // Una bozza non ha iscritti (0327): lo studente non lo vedrebbe.
    if ((int) $corso['is_published'] !== 1) {
        fwrite(STDERR, "Il corso {$c} («{$corso['title']}») e' in bozza: va pubblicato prima.\n");
        exit(1);
    }
}

// Un solo hash per tutti: calcolarne 500 costerebbe minuti, e la password
// e' la stessa.
$hash = password_hash($password, PASSWORD_DEFAULT);

$utente = $pdo->prepare(
    "INSERT IGNORE INTO users
        (email, password_hash, first_name, last_name, role, is_active, email_verified_at,
         welcome_seen_at, invite_pending, must_change_password, name_display)
     VALUES (:email, :hash, 'Prova', :cognome, 'studente', 1, NOW(), NOW(), 0, 0, 'full')"
);
$iscrivi = $pdo->prepare(
    'INSERT IGNORE INTO enrollments (user_id, course_id, confirmation_pending) VALUES (:u, :c, 0)'
);
$primaLezione = $pdo->prepare(
    'SELECT l.id FROM lessons l INNER JOIN modules m ON m.id = l.module_id
     WHERE m.course_id = :c ORDER BY m.position, m.id, l.position, l.id LIMIT 1'
);
$fatta = $pdo->prepare('INSERT IGNORE INTO lesson_progress (user_id, lesson_id) VALUES (:u, :l)');
$trova = $pdo->prepare('SELECT id FROM users WHERE email = :email');

$lezioni = [];
foreach ($corsi as $c) {
    $primaLezione->execute(['c' => $c]);
    $lezioni[$c] = $primaLezione->fetchColumn() ?: null;
}

$pdo->beginTransaction();
$nuovi = 0;

for ($n = 1; $n <= $quanti; $n++) {
    $email = indirizzo($n);
    $utente->execute(['email' => $email, 'hash' => $hash, 'cognome' => sprintf('Carico %03d', $n)]);
    $nuovi += $utente->rowCount();
    $trova->execute(['email' => $email]);
    $id = (int) $trova->fetchColumn();

    foreach ($corsi as $c) {
        $iscrivi->execute(['u' => $id, 'c' => $c]);

        if ($n % 2 === 0 && $lezioni[$c] !== null) {
            $fatta->execute(['u' => $id, 'l' => (int) $lezioni[$c]]);
        }
    }
}

$pdo->commit();

echo "Studenti del test di carico: {$quanti} (nuovi {$nuovi}), iscritti a " . count($corsi) . " corso/i.\n"
    . "Indirizzi da " . indirizzo(1) . ' a ' . indirizzo($quanti) . ".\n";
